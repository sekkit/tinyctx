#!/usr/bin/env bash
# tinyctx-up — one-shot start / health-check for the tinyctx stack.
#
# Idempotent: safe to run any time. Does the right thing whether the
# service is already running, dead, or never started.
#
# Usage:
#   tinyctx-up           # start (idempotent) + health check
#   tinyctx-up restart   # force restart the launchd job
#   tinyctx-up stop      # unload the launchd job
#   tinyctx-up status    # just print status, don't start anything
#   tinyctx-up logs      # tail the JSONL request_trace stream
set -uo pipefail

LABEL="com.tinyctx.proxy"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PROXY_URL="http://127.0.0.1:4141"
LOG_DIR="$HOME/.tinyctx/logs"

VENV_PY="$HOME/dev/tinyctx/.venv/bin/python"
[ -x "$VENV_PY" ] || VENV_PY="$(command -v python3 || true)"

# Resolve the *configured* local backend so the health gate reflects reality
# (DeepSeek cloud / LMStudio / Ollama / …) instead of a hardcoded LMStudio
# assumption. Falls back to the legacy LMStudio URL if config can't be read.
_local_backend_url() {
  [ -n "$VENV_PY" ] || { echo ""; return; }
  "$VENV_PY" - <<'PY' 2>/dev/null
try:
    from tinyctx.config import load_config
    print((load_config().local.base_url or "").rstrip("/"))
except Exception:
    print("")
PY
}
LOCAL_URL="$(_local_backend_url)"
[ -n "$LOCAL_URL" ] || LOCAL_URL="http://127.0.0.1:1234/v1"
case "$LOCAL_URL" in
  *127.0.0.1*|*localhost*|*0.0.0.0*) LOCAL_IS_LOCAL=1 ;;
  *)                                 LOCAL_IS_LOCAL=0 ;;
esac

green() { printf "\033[32m%s\033[0m\n" "$*"; }
red()   { printf "\033[31m%s\033[0m\n" "$*"; }
dim()   { printf "\033[90m%s\033[0m\n" "$*"; }

check_alive() {
  curl -s --max-time 2 "$1" > /dev/null 2>&1
}

cmd_status() {
  printf "  local backend  (%s)  " "$LOCAL_URL"
  if check_alive "$LOCAL_URL/models"; then green "alive"
  elif [ "$LOCAL_IS_LOCAL" = "1" ]; then red "DEAD — start your local model server + load a model"
  else red "unreachable"; fi

  printf "  tinyctx-proxy  (%s)  " "$PROXY_URL"
  if check_alive "$PROXY_URL/"; then green "alive"; else red "DEAD"; fi

  if launchctl list | grep -q "$LABEL"; then
    local line=$(launchctl list | grep "$LABEL")
    local pid=$(echo "$line" | awk '{print $1}')
    local rc=$(echo "$line"  | awk '{print $2}')
    printf "  launchd job    %-22s  pid=%s  last-exit=%s\n" "$LABEL" "$pid" "$rc"
  else
    printf "  launchd job    %s  " "$LABEL"; red "NOT LOADED"
  fi
}

# launchd / system spawns may have a minimal PATH; export the dirs
# where uv / npm / homebrew typically install binaries so each
# bootstrap can detect already-installed tools (serena, gitnexus, etc.).
_bootstrap_path() {
  echo "$HOME/.local/bin:$HOME/.local/node/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
}

_gitnexus_bootstrap_async() {
  # Fire-and-forget. Detached + nohup'd so we don't block proxy start.
  # Bootstrap is fully idempotent — fast no-op when already configured.
  local venv_py="$HOME/dev/tinyctx/.venv/bin/python"
  [ -x "$venv_py" ] || venv_py="$(command -v python3)"
  [ -n "$venv_py" ] || return 0
  (cd "$HOME/dev/tinyctx" 2>/dev/null \
   && PATH="$(_bootstrap_path)" nohup "$venv_py" \
        -m tinyctx.gitnexus_bootstrap install --quiet \
        >> "$LOG_DIR/gitnexus-bootstrap.log" 2>&1 &)
}

_graphify_bootstrap_async() {
  # Fire-and-forget. Iterates all registered projects so each codex
  # session sees the AGENTS.md / hooks.json wiring without manual setup.
  local venv_py="$HOME/dev/tinyctx/.venv/bin/python"
  [ -x "$venv_py" ] || venv_py="$(command -v python3)"
  [ -n "$venv_py" ] || return 0
  (cd "$HOME/dev/tinyctx" 2>/dev/null \
   && PATH="$(_bootstrap_path)" nohup "$venv_py" \
        -m tinyctx.graphify_bootstrap install --quiet --all-registered \
        >> "$LOG_DIR/graphify-bootstrap.log" 2>&1 &)
}

_serena_bootstrap_async() {
  local venv_py="$HOME/dev/tinyctx/.venv/bin/python"
  [ -x "$venv_py" ] || venv_py="$(command -v python3)"
  [ -n "$venv_py" ] || return 0
  (cd "$HOME/dev/tinyctx" 2>/dev/null \
   && PATH="$(_bootstrap_path)" nohup "$venv_py" \
        -m tinyctx.serena_bootstrap install --quiet \
        >> "$LOG_DIR/serena-bootstrap.log" 2>&1 &)
}

_caveman_bootstrap_async() {
  local venv_py="$HOME/dev/tinyctx/.venv/bin/python"
  [ -x "$venv_py" ] || venv_py="$(command -v python3)"
  [ -n "$venv_py" ] || return 0
  (cd "$HOME/dev/tinyctx" 2>/dev/null \
   && PATH="$(_bootstrap_path)" nohup "$venv_py" \
        -m tinyctx.caveman_bootstrap install --quiet \
        >> "$LOG_DIR/caveman-bootstrap.log" 2>&1 &)
}

_scout_hook_bootstrap_async() {
  local venv_py="$HOME/dev/tinyctx/.venv/bin/python"
  [ -x "$venv_py" ] || venv_py="$(command -v python3)"
  [ -n "$venv_py" ] || return 0
  (cd "$HOME/dev/tinyctx" 2>/dev/null \
   && PATH="$(_bootstrap_path)" nohup "$venv_py" \
        -m tinyctx.scout_hook_bootstrap install --quiet \
        >> "$LOG_DIR/scout-hook-bootstrap.log" 2>&1 &)
}

_scout_trigger_bootstrap_async() {
  # PostToolUse trigger hook: keeps scout fresh between sessions. The hook
  # self-gates on scout-cache existence, so it is inert for repos tinyctx
  # has never scouted (and never touches a provider API).
  local venv_py="$HOME/dev/tinyctx/.venv/bin/python"
  [ -x "$venv_py" ] || venv_py="$(command -v python3)"
  [ -n "$venv_py" ] || return 0
  (cd "$HOME/dev/tinyctx" 2>/dev/null \
   && PATH="$(_bootstrap_path)" nohup "$venv_py" \
        -m tinyctx.scout_trigger install --quiet \
        >> "$LOG_DIR/scout-trigger-bootstrap.log" 2>&1 &)
}

cmd_start() {
  # Only hard-fail when the configured local backend is a localhost server
  # that's down (a real blocker). Cloud backends (DeepSeek etc.) are assumed
  # reachable; the proxy-up check below is the real gate for those.
  if [ "$LOCAL_IS_LOCAL" = "1" ] && ! check_alive "$LOCAL_URL/models"; then
    red "Local model backend is not responding at $LOCAL_URL."
    echo "  Start your local model server (LM Studio / Ollama / …) and load a model,"
    echo "  then re-run: tinyctx-up"
    return 1
  fi
  if [ ! -f "$PLIST" ]; then
    red "launchd plist missing: $PLIST"
    return 1
  fi

  # `-w` makes load() idempotent + persistent across reboots.
  launchctl load -w "$PLIST" 2>/dev/null

  for _ in $(seq 1 20); do
    if check_alive "$PROXY_URL/"; then break; fi
    sleep 0.3
  done

  # All bootstraps are fully idempotent + async detached so they don't
  # block proxy startup. Each writes to its own ~/.tinyctx/logs/*.log.
  _gitnexus_bootstrap_async
  _graphify_bootstrap_async
  _serena_bootstrap_async
  _caveman_bootstrap_async
  _scout_hook_bootstrap_async
  _scout_trigger_bootstrap_async

  cmd_status
  echo
  if check_alive "$PROXY_URL/"; then
    green "tinyctx is up."
    echo
    echo "Use it with codex:"
    dim   "  codex --profile tinyctx                    # interactive"
    dim   "  codex exec --profile tinyctx \"do X\"        # one-shot"
    echo
    echo "Watch routing decisions live:"
    dim   "  tinyctx-trace --watch"
    return 0
  else
    red "tinyctx-proxy did not come up within 6s. Check ~/.tinyctx/logs/proxy.err"
    return 1
  fi
}

cmd_stop() {
  launchctl unload "$PLIST" 2>/dev/null
  pkill -f "tinyctx.proxy" 2>/dev/null
  cmd_status
  green "tinyctx stopped."
}

cmd_restart() {
  launchctl unload "$PLIST" 2>/dev/null
  sleep 1
  launchctl load -w "$PLIST"
  for _ in $(seq 1 20); do
    if check_alive "$PROXY_URL/"; then break; fi
    sleep 0.3
  done
  _gitnexus_bootstrap_async
  _graphify_bootstrap_async
  _serena_bootstrap_async
  _caveman_bootstrap_async
  _scout_hook_bootstrap_async
  _scout_trigger_bootstrap_async
  cmd_status
  green "tinyctx restarted."
}

cmd_logs() {
  local today="$LOG_DIR/tinyctx-$(date +%Y%m%d).jsonl"
  if [ ! -f "$today" ]; then
    red "no log yet at $today; run a request first."
    return 1
  fi
  echo "tailing $today (Ctrl-C to exit)"
  tail -F "$today"
}

case "${1:-start}" in
  start|"")     cmd_start ;;
  stop)         cmd_stop ;;
  restart)      cmd_restart ;;
  status)       cmd_status ;;
  logs)         cmd_logs ;;
  *)
    cat <<USAGE
usage: tinyctx-up [start|stop|restart|status|logs]
  start     start (idempotent) + health check     (default)
  stop      unload the launchd job
  restart   force restart
  status    print health, don't change anything
  logs      tail today's request_trace JSONL
USAGE
    exit 2
    ;;
esac
