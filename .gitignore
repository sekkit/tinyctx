# Local secrets / state
secrets/
*.env
.env

# Explicitly allow committed templates (overrides *.env / secrets/)
!examples/secrets.env.example

# Claude Code per-session metadata (worktrees, agent state, todos)
.claude/

# Codex per-project hook config (auto-generated by graphify codex install
# and tinyctx bootstrap modules; contains absolute per-machine paths so
# must NOT be committed). See tinyctx/scout_hook_bootstrap.py for the
# user-scoped equivalent at ~/.codex/hooks.json.
.codex/

# graphify writes a project-root AGENTS.md when its codex skill is enabled.
# The bundled fallback lives at tinyctx/templates/AGENTS.md and is injected
# at request time (see tinyctx/agent_rules.py); the root copy is a
# per-developer artifact so it stays out of the repo.
/AGENTS.md
