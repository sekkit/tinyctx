{#- ============================================================= #}
{#- Qwen3.6 Barubary Hermes-JSON variant v1                       #}
{#- Target: Qwen3.6-* (LMStudio 0.4.x with llama.cpp ≥ 2.14)      #}
{#-                                                                #}
{#- Derived from Barubary v1 (21 fixes preserved). Single change:  #}
{#- tool calls are rendered/instructed in STANDARD HERMES JSON     #}
{#- format instead of qwen-pythonic XML, so LMStudio's built-in    #}
{#- llama.cpp tool-call parser can extract them WITHOUT a wire-    #}
{#- level translator on the proxy side.                            #}
{#-                                                                #}
{#- WHY YOU MIGHT WANT THIS:                                       #}
{#-   * You want LMStudio's `/v1/responses` to emit structured     #}
{#-     `function_call` output items directly.                     #}
{#-   * You're not using tinyctx and have no other translator.    #}
{#-                                                                #}
{#- WHY YOU MIGHT NOT WANT THIS (read before switching):           #}
{#-   * qwen3-coder family was SFT/RL-trained on the pythonic XML  #}
{#-     format. Asking it to emit Hermes JSON is OFF-DISTRIBUTION  #}
{#-     and quality on tool-heavy tasks may drop measurably.       #}
{#-   * llama.cpp's Hermes parser has its own quirks: it can fail  #}
{#-     on multi-line string args, escaped quotes inside strings,  #}
{#-     nested objects.                                            #}
{#-   * If you're already using tinyctx's tool_call_translator, no #}
{#-     reason to switch — keep the original Barubary template.    #}
{#-                                                                #}
{#- A/B test recommendation:                                       #}
{#-   1. Save the original Barubary template to                    #}
{#-      ~/qwen3.5-barubary-attuned-v1.jinja                       #}
{#-   2. Save THIS file to                                         #}
{#-      ~/qwen3.6-barubary-hermes-json-v1.jinja                   #}
{#-   3. In LMStudio model settings, swap between them; run the    #}
{#-      same codex agent task on both and compare:                #}
{#-      - tool call success rate                                  #}
{#-      - argument fidelity (especially multi-line code, paths    #}
{#-        with quotes, deeply-nested args)                        #}
{#-      - end-to-end task completion rate                         #}
{#-                                                                #}
{#- Diffs from Barubary v1:                                        #}
{#-   ▶ <tool_call> body changed from XML to JSON-on-one-block.    #}
{#-   ▶ System prompt instruction example changed accordingly.     #}
{#-   ▶ Renders historical assistant tool_calls back into JSON     #}
{#-     form instead of <function=...><parameter=...>.             #}
{#-   ▶ FIX18 (clean newline boundaries) preserved — Hermes JSON   #}
{#-     parsers benefit from blank-line separation between calls.  #}
{#-   ▶ All other fixes (1-21) preserved verbatim.                 #}
{#- ============================================================= #}

{%- set template_version = "qwen3.6-barubary-hermes-json-v1" %}

{#- ── Config with safe defaults ─────────────────────────────── #}
{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- set add_vision_id = add_vision_id if add_vision_id is defined else false %}
{%- set enable_thinking = enable_thinking if enable_thinking is defined else true %}
{%- set auto_disable_thinking_with_tools = auto_disable_thinking_with_tools if auto_disable_thinking_with_tools is defined else true %}
{%- set max_tool_arg_chars = max_tool_arg_chars if max_tool_arg_chars is defined else 0 %}
{%- set max_tool_response_chars = max_tool_response_chars if max_tool_response_chars is defined else 0 %}

{#- FIX21: precompute _has_tools ─────────────────────────────── #}
{%- set _has_tools = (tools is defined and tools and tools is iterable and tools is not mapping) %}

{#- FIX19: auto-disable thinking when tools active ─────────── #}
{%- set _thinking = enable_thinking %}
{%- if auto_disable_thinking_with_tools and _has_tools %}
    {%- set _thinking = false %}
{%- endif %}

{#- ── render_content macro ──────────────────────────────────── #}
{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if item is mapping %}
                {%- if item.type == 'image' or 'image' in item or 'image_url' in item %}
                    {%- if is_system_content %}
                        {{- raise_exception('System message cannot contain images.') }}
                    {%- endif %}
                    {%- if do_vision_count %}
                        {%- set image_count.value = image_count.value + 1 %}
                    {%- endif %}
                    {%- if add_vision_id %}
                        {{- 'Picture ' ~ image_count.value ~ ': ' }}
                    {%- endif %}
                    {{- '<|vision_start|><|image_pad|><|vision_end|>' }}
                {%- elif item.type == 'video' or 'video' in item %}
                    {%- if is_system_content %}
                        {{- raise_exception('System message cannot contain videos.') }}
                    {%- endif %}
                    {%- if do_vision_count %}
                        {%- set video_count.value = video_count.value + 1 %}
                    {%- endif %}
                    {%- if add_vision_id %}
                        {{- 'Video ' ~ video_count.value ~ ': ' }}
                    {%- endif %}
                    {{- '<|vision_start|><|video_pad|><|vision_end|>' }}
                {%- elif 'text' in item %}
                    {{- item.text }}
                {%- else %}
                    {{- raise_exception('Unexpected item type in content.') }}
                {%- endif %}
            {%- else %}
                {{- item | string }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}

{#- ── Guard ──────────────────────────────────────────────────── #}
{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}

{#- ── Extract leading system/developer message ────────────────── #}
{%- set _first_role = messages[0].role %}
{%- if _first_role == 'system' or _first_role == 'developer' %}
    {%- set _sys_msg = messages[0] %}
    {%- set _msgs = messages[1:] %}
{%- else %}
    {%- set _sys_msg = none %}
    {%- set _msgs = messages %}
{%- endif %}

{#- ── Tools block (HERMES JSON variant) OR plain system block ── #}
{%- if _has_tools %}
    {{- '<|im_start|>system\n' }}
    {{- '# Tools\n\nYou have access to the following functions:\n\n<tools>' }}
    {%- for tool in tools %}
        {{- '\n' }}
        {{- tool | tojson }}
    {%- endfor %}
    {{- '\n</tools>' }}
    {{- '\n\nIf you choose to call a function ONLY reply with a single block in this EXACT format with NO suffix:\n\n' }}
    {{- '<tool_call>\n' }}
    {{- '{"name": "function_name", "arguments": {"param_a": "value_a", "param_b": 42, "nested_param": {"k": "v"}}}\n' }}
    {{- '</tool_call>' }}
    {{- '\n\n<IMPORTANT>\nReminder:\n' }}
    {{- '- The body inside <tool_call>...</tool_call> MUST be a single valid JSON object\n' }}
    {{- '- The JSON object MUST contain exactly the keys "name" (string) and "arguments" (object)\n' }}
    {{- '- Required parameters MUST be specified inside "arguments"\n' }}
    {{- '- You may provide optional reasoning for your function call in natural language BEFORE the tool_call block, but NOT after\n' }}
    {{- '- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n' }}
    {{- '- When making multiple function calls, emit each <tool_call>...</tool_call> block separated by a blank line\n' }}
    {{- '- Strings in JSON MUST be enclosed in double quotes; escape internal double quotes with backslash\n' }}
    {{- '- Numbers, booleans (true/false), null, arrays, and nested objects are allowed values inside "arguments"\n' }}
    {{- '</IMPORTANT>' }}
    {%- if _sys_msg is not none %}
        {%- set _sc = render_content(_sys_msg.content, false, true) | trim %}
        {%- if _sc %}
            {{- '\n\n' + _sc }}
        {%- endif %}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if _sys_msg is not none %}
        {%- set _sc = render_content(_sys_msg.content, false, true) | trim %}
        {{- '<|im_start|>system\n' + _sc + '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}

{#- ── Compute last real-user-query index ────────────────────── #}
{#- FIX2 #}
{%- set _last_idx = _msgs | length - 1 %}
{%- set ns = namespace(multi_step_tool=true, last_query_index=_last_idx) %}
{%- for message in _msgs[::-1] %}
    {%- set index = (_msgs | length - 1) - loop.index0 %}
    {%- if ns.multi_step_tool and message.role == 'user' %}
        {%- set _rc = render_content(message.content, false) | trim %}
        {%- if not (_rc.startswith('<tool_response>') and _rc.endswith('</tool_response>')) %}
            {%- set ns.multi_step_tool = false %}
            {%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{#- FIX17: deep agent loop fallback ────────────────────────── #}
{%- if ns.multi_step_tool %}
    {%- if _last_idx > 50 %}
        {%- set ns.last_query_index = _last_idx %}
    {%- else %}
        {%- set ns.last_query_index = 0 %}
    {%- endif %}
{%- endif %}

{#- ── Main render loop ──────────────────────────────────────── #}
{%- set ns2 = namespace(prev_role='') %}
{%- for message in _msgs %}
    {%- set content = render_content(message.content, true) | trim %}

    {%- if message.role == 'user' %}
        {{- '<|im_start|>user\n' + content + '<|im_end|>\n' }}

    {%- elif message.role == 'assistant' %}
        {#- ── Extract reasoning_content ── #}
        {%- set reasoning_content = '' %}
        {%- if message.reasoning_content is defined and message.reasoning_content is not none %}
            {%- if message.reasoning_content is string %}
                {%- set reasoning_content = message.reasoning_content %}
            {%- else %}
                {%- set reasoning_content = message.reasoning_content | string %}
            {%- endif %}
        {%- else %}
            {%- if '</think>' in content %}
                {%- set reasoning_content = content.split('</think>')[0].rstrip('\n').split('<think>')[-1].lstrip('\n') %}
                {%- set content = content.split('</think>')[-1].lstrip('\n') %}
            {%- endif %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content | trim %}

        {#- ── Render assistant turn ── #}
        {%- if loop.index0 > ns.last_query_index %}
            {%- if _thinking %}
                {{- '<|im_start|>assistant\n<think>\n' + reasoning_content + '\n</think>\n\n' + content }}
            {%- else %}
                {{- '<|im_start|>assistant\n<think>\n\n</think>\n\n' + content }}
            {%- endif %}
        {%- else %}
            {{- '<|im_start|>assistant\n' + content }}
        {%- endif %}

        {#- ── Render tool_calls (HERMES JSON variant) ── #}
        {%- if message.tool_calls is defined and message.tool_calls
               and message.tool_calls is iterable
               and message.tool_calls is not mapping %}
            {%- for tool_call in message.tool_calls %}
                {#- FIX10 — tc alias avoids shadowing tool_call loop var #}
                {%- if tool_call.function is defined and tool_call.function is not none %}
                    {%- set tc = tool_call.function %}
                {%- else %}
                    {%- set tc = tool_call %}
                {%- endif %}

                {#- FIX15+FIX18 — clean boundaries #}
                {%- if loop.first %}
                    {%- if content | trim %}
                        {{- '\n\n<tool_call>\n' }}
                    {%- else %}
                        {{- '<tool_call>\n' }}
                    {%- endif %}
                {%- else %}
                    {{- '\n\n<tool_call>\n' }}
                {%- endif %}

                {#- ── Render arguments as a SINGLE JSON object ── #}
                {%- set _args_obj = namespace(value={}) %}
                {%- if tc.arguments is defined and tc.arguments is not none %}
                    {%- if tc.arguments is mapping %}
                        {%- set _args_obj.value = tc.arguments %}
                    {%- elif tc.arguments is string and tc.arguments %}
                        {#- FIX9: string args pass-through. We attempt to    #}
                        {#- treat the string as already-JSON; if the host    #}
                        {#- gave us a plain string we wrap it.               #}
                        {%- set _args_obj.value = tc.arguments %}
                    {%- endif %}
                {%- endif %}

                {#- Build the JSON object body. We special-case string    #}
                {#- "arguments" so we don't double-encode JSON-as-string. #}
                {%- if _args_obj.value is string %}
                    {#- assume already-serialized JSON; pass through #}
                    {%- set _body = '{"name": ' + (tc.name | tojson) + ', "arguments": ' + _args_obj.value + '}' %}
                {%- else %}
                    {#- FIX16: truncation guard happens during tojson rendering  #}
                    {#- of the dict-form by serializing per-key. For simplicity  #}
                    {#- we serialize the whole arguments object then check size. #}
                    {%- set _args_json = _args_obj.value | tojson %}
                    {%- if max_tool_arg_chars > 0 and _args_json | length > max_tool_arg_chars %}
                        {#- Truncation rendered into a stub string field; not   #}
                        {#- ideal but signals "too long" while staying valid    #}
                        {#- JSON.                                                #}
                        {%- set _args_json = '{"_truncated": "' + (_args_json | length | string) + ' chars exceeded ' + (max_tool_arg_chars | string) + '"}' %}
                    {%- endif %}
                    {%- set _body = '{"name": ' + (tc.name | tojson) + ', "arguments": ' + _args_json + '}' %}
                {%- endif %}
                {{- _body }}

                {%- if loop.last %}
                    {{- '\n</tool_call>\n' }}
                {%- else %}
                    {{- '\n</tool_call>' }}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
        {{- '<|im_end|>\n' }}

    {%- elif message.role == 'tool' %}
        {#- FIX11 — ns2.prev_role replaces loop.previtem #}
        {%- if ns2.prev_role != 'tool' %}
            {{- '<|im_start|>user' }}
        {%- endif %}
        {#- FIX16 #}
        {%- if max_tool_response_chars > 0 and content | length > max_tool_response_chars %}
            {%- set content = content[:max_tool_response_chars] + '\n[TRUNCATED — original length ' ~ (content | length | string) ~ ' chars]' %}
        {%- endif %}
        {{- '\n<tool_response>\n' + content + '\n</tool_response>' }}
        {#- FIX11 #}
        {%- if loop.last %}
            {{- '<|im_end|>\n' }}
        {%- else %}
            {%- set _next_role = _msgs[loop.index0 + 1].role %}
            {%- if _next_role != 'tool' %}
                {{- '<|im_end|>\n' }}
            {%- endif %}
        {%- endif %}

    {%- elif message.role == 'system' or message.role == 'developer' %}
        {#- FIX4: skip — already rendered above #}

    {%- else %}
        {#- FIX20: graceful unknown-role fallback #}
        {{- '<|im_start|>user\n[' + message.role + ']: ' + content + '<|im_end|>\n' }}
    {%- endif %}

    {%- set ns2.prev_role = message.role %}
{%- endfor %}

{#- ── Generation prompt ──────────────────────────────────────── #}
{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' }}
    {%- if not _thinking %}
        {{- '<think>\n\n</think>\n\n' }}
    {%- else %}
        {{- '<think>\n' }}
    {%- endif %}
{%- endif %}
