# tinyctx secrets — copy this file to ~/.tinyctx/secrets.env and chmod 600.
#
#   cp examples/secrets.env.example ~/.tinyctx/secrets.env
#   chmod 600 ~/.tinyctx/secrets.env
#   $EDITOR ~/.tinyctx/secrets.env       # paste your real keys
#
# scripts/start.sh sources this file at proxy startup, so any KEY=VAL line
# becomes a process env var. The launchd plist runs start.sh, so secrets
# survive a reboot without any extra wiring.
#
# This file MUST NOT be committed. The repo's .gitignore already excludes
# it; if you store the file outside ~/.tinyctx/, double-check before
# `git add`.
#
# ── per-backend keys ──────────────────────────────────────────────────
# Local backend (DeepSeek, OpenRouter, Together, etc.). Match the
# `api_key_env` value in your [local] section of ~/.tinyctx/config.toml.
TINYCTX_LOCAL_API_KEY="REPLACE_ME_with_your_local_backend_API_key"

# Frontier backend. Leave commented to forward codex's own Authorization
# header (which is the recommended setup for chatgpt.com/backend-api/codex).
# TINYCTX_FRONTIER_API_KEY="REPLACE_ME_with_your_frontier_API_key"

# ── notes ──────────────────────────────────────────────────────────────
# - DeepSeek keys start with "sk-" and look like a 32-char hex blob.
# - OpenAI keys start with "sk-proj-" or "sk-svcacct-".
# - OpenRouter keys start with "sk-or-".
# - LMStudio / Ollama don't need keys at all; you can leave the placeholder
#   value in here and it'll be sent but ignored.
